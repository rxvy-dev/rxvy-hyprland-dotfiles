#!/usr/bin/env python3
"""Prism Settings — GTK4 / libadwaita control panel for the Prism Hyprland rice."""
import os
import sys
import shutil
import threading

sys.path.insert(0, os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "prism", "lib"))
import prismlib as P  # noqa: E402

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gtk, Adw, Gio, GLib, Gdk, GdkPixbuf  # noqa: E402

APP_ID = "dev.prism.Settings"

CSS = b"""
.theme-card { padding: 6px; border-radius: 14px; }
.theme-card picture { border-radius: 10px; }
.theme-card.current { box-shadow: inset 0 0 0 3px @accent_color; background: alpha(@accent_color, 0.08); }
.swatch { min-width: 14px; min-height: 14px; border-radius: 99px; border: 1px solid alpha(currentColor, 0.2); }
.wall-card { padding: 4px; border-radius: 12px; }
.wall-card.current { box-shadow: inset 0 0 0 3px @accent_color; }
.wall-card picture { border-radius: 9px; }
.hero-title { font-size: 28px; font-weight: 800; }
.kind-tag { font-size: 10px; font-weight: bold; padding: 1px 7px; border-radius: 99px; background: alpha(currentColor, 0.1); }
"""

THEME_LOOK_KEYS = ["rounding", "gaps_in", "gaps_out", "border_size", "blur", "shadows", "animations",
                   "inactive_opacity", "terminal_opacity", "bar_style", "bar_position", "font_ui",
                   "font_mono", "font_size"]


class Settings:
    """Shared state + debounced apply."""

    def __init__(self, win):
        self.win = win
        self.s = P.load_settings()
        self._pending = None
        self._wallpaper = False
        self._busy = False

    def theme(self):
        return P.load_theme(self.s["theme"]) or P.list_themes()[0]

    def resolved(self):
        return P.resolve(self.theme(), self.s)

    def set(self, key, value, wallpaper=False, delay=350):
        if self.s.get(key) == value:
            return
        self.s[key] = value
        P.save_settings(self.s)
        self.schedule(wallpaper, delay)

    def schedule(self, wallpaper=False, delay=350):
        self._wallpaper = self._wallpaper or wallpaper
        if self._pending:
            GLib.source_remove(self._pending)
        self._pending = GLib.timeout_add(delay, self._run)

    def _run(self):
        self._pending = None
        if self._busy:
            self.schedule(self._wallpaper)
            return False
        self._busy = True
        wp, self._wallpaper = self._wallpaper, False
        s = dict(self.s)

        def work():
            try:
                P.apply(s, wallpaper=wp)
            except Exception as e:  # keep the UI alive no matter what
                GLib.idle_add(self.win.toast, "Error: %s" % e)
            finally:
                self._busy = False
        threading.Thread(target=work, daemon=True).start()
        return False


# ----------------------------------------------------------------------------
# Row helpers
# ----------------------------------------------------------------------------
def switch_row(st, title, key, subtitle=None, resolved_key=None, on_change=None):
    row = Adw.SwitchRow(title=title)
    if subtitle:
        row.set_subtitle(subtitle)
    val = st.s.get(key)
    if val is None and resolved_key:
        val = st.resolved()[resolved_key]
    row.set_active(bool(val))

    def changed(r, _p):
        st.set(key, r.get_active())
        if on_change:
            on_change(r.get_active())
    row.connect("notify::active", changed)
    return row


def spin_row(st, title, key, lo, hi, step, digits=0, subtitle=None, resolved_key=None, cast=int):
    adj = Gtk.Adjustment(lower=lo, upper=hi, step_increment=step, page_increment=step * 5)
    row = Adw.SpinRow(title=title, adjustment=adj, digits=digits)
    if subtitle:
        row.set_subtitle(subtitle)
    val = st.s.get(key)
    if val is None and resolved_key:
        val = st.resolved()[resolved_key]
    row.set_value(float(val if val is not None else lo))
    row.connect("notify::value", lambda r, _p: st.set(key, cast(round(r.get_value(), digits) if digits else r.get_value())))
    return row


def combo_row(st, title, key, options, subtitle=None, wallpaper=False, on_change=None):
    """options: list of (value, label)"""
    model = Gtk.StringList.new([lbl for _, lbl in options])
    row = Adw.ComboRow(title=title, model=model)
    if subtitle:
        row.set_subtitle(subtitle)
    values = [v for v, _ in options]
    cur = st.s.get(key)
    row.set_selected(values.index(cur) if cur in values else 0)

    def changed(r, _p):
        v = values[r.get_selected()]
        st.set(key, v, wallpaper=wallpaper)
        if on_change:
            on_change(v)
    row.connect("notify::selected", changed)
    return row


def entry_row(st, title, key, wallpaper=False):
    row = Adw.EntryRow(title=title)
    row.set_text(str(st.s.get(key) or ""))
    row.set_show_apply_button(True)
    row.connect("apply", lambda r: st.set(key, r.get_text().strip(), wallpaper=wallpaper, delay=50))
    return row


def button_row(title, subtitle, label, cb, style=None):
    row = Adw.ActionRow(title=title)
    if subtitle:
        row.set_subtitle(subtitle)
    btn = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
    if style:
        btn.add_css_class(style)
    btn.connect("clicked", lambda *_: cb())
    row.add_suffix(btn)
    row.set_activatable_widget(btn)
    return row


def swatch(color):
    return Gtk.Box(css_classes=["swatch", "sw-" + color.lstrip("#").lower()])


def swatch_css():
    colors = set()
    for t in P.list_themes():
        for k in ("BG", "ACCENT", "ACCENT2", "C1", "C2", "C3", "FG"):
            colors.add(t[k].lstrip("#").lower())
    return "".join(".sw-%s { background: #%s; }\n" % (c, c) for c in colors).encode()


def picture(path, w, h):
    """A picture scaled down on load (keeps the grid compact and memory low)."""
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, w, h, True)
        pic = Gtk.Picture.new_for_paintable(Gdk.Texture.new_for_pixbuf(pb))
    except Exception:
        pic = Gtk.Picture()
    pic.set_content_fit(Gtk.ContentFit.COVER)
    pic.set_can_shrink(True)
    pic.set_size_request(w, h)
    return pic


def scrolled(child):
    sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
    sw.set_child(child)
    return sw


# ----------------------------------------------------------------------------
# Pages
# ----------------------------------------------------------------------------
class ThemesPage(Gtk.Box):
    def __init__(self, st):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.st = st
        self.filter = "all"
        clamp = Adw.Clamp(maximum_size=1100, margin_top=18, margin_bottom=18, margin_start=18, margin_end=18)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        clamp.set_child(box)

        head = Gtk.Box(spacing=12)
        title = Gtk.Label(label="Themes", xalign=0, hexpand=True, css_classes=["hero-title"])
        head.append(title)
        seg = Gtk.Box(css_classes=["linked"], valign=Gtk.Align.CENTER)
        first = None
        for key, label in (("all", "All"), ("retro", "Retro"), ("modern", "Modern")):
            b = Gtk.ToggleButton(label=label)
            if first:
                b.set_group(first)
            else:
                first = b
                b.set_active(True)
            b.connect("toggled", self.on_filter, key)
            seg.append(b)
        head.append(seg)
        box.append(head)

        sub = Gtk.Label(xalign=0, wrap=True, css_classes=["dim-label"],
                        label="Click a theme to apply it everywhere — windows, bar, terminal, launcher, lock screen, "
                              "notifications and GTK apps. Super+T opens a quick picker, Super+Shift+T cycles.")
        box.append(sub)

        self.flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                                max_children_per_line=4, min_children_per_line=1,
                                column_spacing=10, row_spacing=10)
        self.flow.set_filter_func(self.filter_fn)
        box.append(self.flow)
        self.cards = {}
        for t in P.list_themes():
            card = self.make_card(t)
            self.flow.append(card)
        self.mark_current()
        self.append(scrolled(clamp))

    def make_card(self, t):
        btn = Gtk.Button(css_classes=["flat", "theme-card"])
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        thumb = os.path.join(t["DIR"], "thumb.png")
        pic = picture(thumb if os.path.exists(thumb) else (t["WALLPAPER"] or ""), 224, 126)
        v.append(pic)
        row = Gtk.Box(spacing=6, margin_start=4, margin_end=4)
        row.append(Gtk.Label(label=t["NAME"], xalign=0, hexpand=True, css_classes=["heading"]))
        row.append(Gtk.Label(label=t.get("KIND", "modern"), css_classes=["kind-tag"], valign=Gtk.Align.CENTER))
        v.append(row)
        sw = Gtk.Box(spacing=4, margin_start=4, margin_bottom=2)
        for k in ("BG", "ACCENT", "ACCENT2", "C1", "C2", "C3", "FG"):
            sw.append(swatch(t[k]))
        v.append(sw)
        desc = Gtk.Label(label=t.get("DESC", ""), xalign=0, wrap=True, max_width_chars=28,
                         css_classes=["dim-label", "caption"], margin_start=4, margin_end=4)
        v.append(desc)
        btn.set_child(v)
        btn.connect("clicked", self.on_pick, t["ID"])
        child = Gtk.FlowBoxChild()
        child.set_child(btn)
        child.kind = t.get("KIND", "modern")
        self.cards[t["ID"]] = btn
        return child

    def filter_fn(self, child):
        return self.filter == "all" or child.kind == self.filter

    def on_filter(self, btn, key):
        if btn.get_active():
            self.filter = key
            self.flow.invalidate_filter()

    def mark_current(self):
        for tid, b in self.cards.items():
            if tid == self.st.s["theme"]:
                b.add_css_class("current")
            else:
                b.remove_css_class("current")

    def on_pick(self, _b, tid):
        self.st.s["theme"] = tid
        self.st.s["wallpaper"] = None
        for k in THEME_LOOK_KEYS:
            self.st.s[k] = None
        P.save_settings(self.st.s)
        self.st.schedule(wallpaper=True, delay=10)
        self.mark_current()
        self.st.win.toast("Theme: %s" % P.load_theme(tid)["NAME"])
        self.st.win.refresh_pages(skip="themes")


class WallpaperPage(Gtk.Box):
    def __init__(self, st):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.st = st
        clamp = Adw.Clamp(maximum_size=1100, margin_top=18, margin_bottom=18, margin_start=18, margin_end=18)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        clamp.set_child(box)
        box.append(Gtk.Label(label="Wallpaper", xalign=0, css_classes=["hero-title"]))

        grp = Adw.PreferencesGroup()
        self.use_theme = Adw.SwitchRow(title="Use the theme's wallpaper",
                                       subtitle="Switching themes always resets to its own wallpaper")
        self.use_theme.set_active(st.s.get("wallpaper") is None)
        self.use_theme.connect("notify::active", self.on_use_theme)
        grp.add(self.use_theme)
        grp.add(combo_row(st, "Fit", "wallpaper_mode",
                          [("fill", "Fill"), ("fit", "Fit"), ("center", "Center"), ("tile", "Tile"), ("stretch", "Stretch")],
                          wallpaper=True))
        grp.add(button_row("Add your own", "Copied to ~/.config/prism/wallpapers", "Choose image…", self.on_add,
                           "suggested-action"))
        box.append(grp)

        self.flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                                max_children_per_line=5, min_children_per_line=2,
                                column_spacing=8, row_spacing=8)
        box.append(self.flow)
        self.cards = {}
        self.populate()
        self.append(scrolled(clamp))

    def populate(self):
        while (c := self.flow.get_first_child()):
            self.flow.remove(c)
        self.cards = {}
        for w in P.list_wallpapers():
            btn = Gtk.Button(css_classes=["flat", "wall-card"])
            pic = picture(w, 176, 99)
            btn.set_child(pic)
            btn.set_tooltip_text(w)
            btn.connect("clicked", self.on_pick, w)
            self.flow.append(btn)
            self.cards[w] = btn
        self.mark()

    def mark(self):
        cur = self.st.resolved()["wallpaper"]
        for w, b in self.cards.items():
            (b.add_css_class if w == cur else b.remove_css_class)("current")

    def on_pick(self, _b, path):
        self.st.set("wallpaper", path, wallpaper=True, delay=10)
        self.use_theme.set_active(False)
        self.mark()

    def on_use_theme(self, row, _p):
        if row.get_active():
            self.st.set("wallpaper", None, wallpaper=True, delay=10)
            self.mark()

    def on_add(self):
        dlg = Gtk.FileDialog(title="Choose a wallpaper")
        f = Gtk.FileFilter()
        f.set_name("Images")
        for m in ("image/png", "image/jpeg", "image/webp"):
            f.add_mime_type(m)
        store = Gio.ListStore.new(Gtk.FileFilter)
        store.append(f)
        dlg.set_filters(store)

        def done(d, res):
            try:
                gf = d.open_finish(res)
            except GLib.Error:
                return
            src = gf.get_path()
            dst_dir = P.USER_WALL_DIRS[0]
            os.makedirs(dst_dir, exist_ok=True)
            dst = os.path.join(dst_dir, os.path.basename(src))
            if os.path.abspath(src) != os.path.abspath(dst):
                shutil.copy2(src, dst)
            self.populate()
            self.on_pick(None, dst)
        dlg.open(self.get_root(), None, done)


class LookPage(Adw.PreferencesPage):
    def __init__(self, st):
        super().__init__(title="Appearance", icon_name="applications-graphics-symbolic")
        self.st = st
        self.build()

    def build(self):
        st = self.st
        r = st.resolved()
        g = Adw.PreferencesGroup(title="Bar", description="Theme default follows the theme you pick.")
        g.add(combo_row(st, "Bar style", "bar_style",
                        [(None, "Theme default (%s)" % r["BAR_STYLE"]), ("islands", "Islands — floating pills"),
                         ("flat", "Flat — full width"), ("xp", "XP taskbar"), ("classic", "Classic 98 taskbar"),
                         ("terminal", "Terminal status line")]))
        g.add(combo_row(st, "Position", "bar_position",
                        [(None, "Theme default (%s)" % r["BAR_POSITION"]), ("top", "Top"), ("bottom", "Bottom")]))
        g.add(switch_row(st, "24-hour clock", "clock_24h"))
        g.add(switch_row(st, "Show seconds", "show_clock_seconds"))
        self.add(g)

        g = Adw.PreferencesGroup(title="Windows")
        g.add(spin_row(st, "Corner rounding", "rounding", 0, 30, 1, resolved_key="rounding"))
        g.add(spin_row(st, "Inner gaps", "gaps_in", 0, 40, 1, resolved_key="gaps_in"))
        g.add(spin_row(st, "Outer gaps", "gaps_out", 0, 60, 1, resolved_key="gaps_out"))
        g.add(spin_row(st, "Border width", "border_size", 0, 8, 1, resolved_key="border_size"))
        g.add(spin_row(st, "Inactive window opacity", "inactive_opacity", 0.5, 1.0, 0.02, digits=2,
                       resolved_key="inactive_opacity", cast=float))
        g.add(switch_row(st, "Dim inactive windows", "dim_inactive"))
        self.add(g)

        g = Adw.PreferencesGroup(title="Effects")
        g.add(switch_row(st, "Blur", "blur", "Frosted glass behind transparent windows and the bar", resolved_key="blur"))
        g.add(switch_row(st, "Shadows", "shadows", resolved_key="shadows"))
        g.add(combo_row(st, "Animations", "animations",
                        [(None, "Theme default (%s)" % r["ANIMATIONS"]), ("smooth", "Smooth"), ("bouncy", "Bouncy"),
                         ("fast", "Fast"), ("off", "Off")]))
        self.add(g)

        g = Adw.PreferencesGroup(title="Terminal and text")
        g.add(spin_row(st, "Terminal opacity", "terminal_opacity", 0.5, 1.0, 0.02, digits=2,
                       resolved_key="terminal_opacity", cast=float))
        g.add(spin_row(st, "Font size", "font_size", 8, 20, 1, resolved_key="font_size"))
        e1 = Adw.EntryRow(title="Interface font (theme: %s)" % r["FONT_UI"])
        e1.set_text(st.s.get("font_ui") or "")
        e1.set_show_apply_button(True)
        e1.connect("apply", lambda w: st.set("font_ui", w.get_text().strip() or None, delay=50))
        g.add(e1)
        e2 = Adw.EntryRow(title="Monospace font (theme: %s)" % r["FONT_MONO"])
        e2.set_text(st.s.get("font_mono") or "")
        e2.set_show_apply_button(True)
        e2.connect("apply", lambda w: st.set("font_mono", w.get_text().strip() or None, delay=50))
        g.add(e2)
        self.add(g)

        g = Adw.PreferencesGroup()
        g.add(button_row("Reset to theme defaults", "Undo every tweak on this page", "Reset", self.reset, "destructive-action"))
        self.add(g)

    def reset(self):
        for k in THEME_LOOK_KEYS:
            self.st.s[k] = None
        self.st.s["dim_inactive"] = False
        P.save_settings(self.st.s)
        self.st.schedule()
        self.st.win.refresh_pages()
        self.st.win.toast("Appearance reset to theme defaults")


