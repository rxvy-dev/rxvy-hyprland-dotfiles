        fm.set_active(int(st.s.get("follow_mouse", 1)) == 1)
        fm.connect("notify::active", lambda r, _p: st.set("follow_mouse", 1 if r.get_active() else 0))
        g.add(fm)
        self.add(g)


class DisplayPage(Adw.PreferencesPage):
    def __init__(self, st):
        super().__init__(title="Displays", icon_name="video-display-symbolic")
        self.st = st
        mons = P.monitors()
        if not mons:
            g = Adw.PreferencesGroup(title="No monitors found",
                                     description="Display settings need a running Hyprland session.")
            self.add(g)
            return
        saved = {m["name"]: m for m in st.s.get("monitors", [])}
        self.rows = {}
        for m in mons:
            name = m["name"]
            cur = saved.get(name, {})
            g = Adw.PreferencesGroup(title=name, description="%s %s" % (m.get("make", ""), m.get("model", "")))
            modes = ["preferred", "highrr", "highres"]
            for mode in m.get("availableModes", []):
                clean = mode.replace("Hz", "")
                if clean not in modes:
                    modes.append(clean)
            mrow = Adw.ComboRow(title="Resolution & refresh", model=Gtk.StringList.new(modes))
            live = "%dx%d@%.2f" % (m["width"], m["height"], m["refreshRate"])
            want = cur.get("mode") or (live if live in modes else "preferred")
            mrow.set_selected(modes.index(want) if want in modes else 0)
            g.add(mrow)
            srow = Adw.SpinRow(title="Scale", digits=2,
                               adjustment=Gtk.Adjustment(lower=0.5, upper=3, step_increment=0.25, page_increment=0.5))
            srow.set_value(float(cur.get("scale", m.get("scale", 1))))
            g.add(srow)
            prow = Adw.EntryRow(title="Position (auto, or e.g. 1920x0)")
            prow.set_text(str(cur.get("position", "auto")))
            g.add(prow)
            drow = Adw.SwitchRow(title="Enabled")
            drow.set_active(not cur.get("disabled", False))
            g.add(drow)
            self.rows[name] = (modes, mrow, srow, prow, drow)
            self.add(g)
        g = Adw.PreferencesGroup()
        g.add(button_row("Apply display settings", "If something goes wrong, edit ~/.config/prism/settings.json from a TTY",
                         "Apply", self.apply, "suggested-action"))
        self.add(g)

    def apply(self):
        out = []
        for name, (modes, mrow, srow, prow, drow) in self.rows.items():
            out.append({"name": name, "mode": modes[mrow.get_selected()], "scale": round(srow.get_value(), 2),
                        "position": prow.get_text().strip() or "auto", "disabled": not drow.get_active()})
        if all(m["disabled"] for m in out):
            self.st.win.toast("Refusing to disable every monitor")
            return
        self.st.set("monitors", out, delay=10)
        self.st.win.toast("Display settings applied")


class PowerPage(Adw.PreferencesPage):
    def __init__(self, st):
        super().__init__(title="Power & Lock", icon_name="system-shutdown-symbolic")
        mins = lambda n: n * 60  # noqa: E731
        times = [(0, "Never"), (mins(1), "1 minute"), (mins(2), "2 minutes"), (mins(5), "5 minutes"),
                 (mins(10), "10 minutes"), (mins(15), "15 minutes"), (mins(30), "30 minutes"), (mins(60), "1 hour")]
        g = Adw.PreferencesGroup(title="Idle")
        g.add(combo_row(st, "Lock screen after", "lock_timeout", times))
        g.add(combo_row(st, "Turn screen off after", "screen_off_timeout", times))
        g.add(combo_row(st, "Suspend after", "suspend_timeout", times))
        g.add(button_row("Lock now", "Super+L", "Lock", lambda: P.spawn(["loginctl", "lock-session"])))
        self.add(g)

        g = Adw.PreferencesGroup(title="Night light", description="Warmer colors in the evening (hyprsunset). Super+N toggles.")
        nl = Adw.SwitchRow(title="Night light")
        nl.set_active(bool(st.s.get("night_light")))

        def nl_changed(r, _p):
            st.s["night_light"] = r.get_active()
            P.save_settings(st.s)
            P.nightlight_runtime(st.s)
        nl.connect("notify::active", nl_changed)
        g.add(nl)
        tr = Adw.SpinRow(title="Temperature", subtitle="Kelvin — lower is warmer",
                         adjustment=Gtk.Adjustment(lower=2500, upper=6500, step_increment=100, page_increment=500))
        tr.set_value(int(st.s.get("night_temp", 4500)))

        def t_changed(r, _p):
            st.s["night_temp"] = int(r.get_value())
            P.save_settings(st.s)
            if st.s.get("night_light"):
                P.nightlight_runtime(st.s)
        tr.connect("notify::value", t_changed)
        g.add(tr)
        self.add(g)


class AppsPage(Adw.PreferencesPage):
    def __init__(self, st):
        super().__init__(title="Apps & Startup", icon_name="application-x-executable-symbolic")
        self.st = st
        g = Adw.PreferencesGroup(title="Default apps", description="Used by Super+Return, Super+B and Super+E.")
        g.add(entry_row(st, "Terminal", "terminal"))
        g.add(entry_row(st, "Browser", "browser"))
        g.add(entry_row(st, "File manager", "files"))
        self.add(g)

        g = Adw.PreferencesGroup(title="fastfetch")
        g.add(combo_row(st, "Logo", "fastfetch_logo",
                        [("prism", "Prism"), ("arch", "Arch"), ("arch_small", "Arch (small)"), ("none", "None")]))
        g.add(button_row("Try it", None, "Run fastfetch",
                         lambda: P.spawn([st.s.get("terminal", "kitty"), "--hold", "fastfetch"])))
        self.add(g)

        self.auto = Adw.PreferencesGroup(title="Autostart", description="Commands run when you log in.")
        self.add(self.auto)
        self.auto_rows = []
        self.add_entry = Adw.EntryRow(title="Add a command (e.g. discord --start-minimized)")
        self.add_entry.set_show_apply_button(True)
        self.add_entry.connect("apply", self.on_add)
        self.render_auto()

    def render_auto(self):
        for r in self.auto_rows:
            self.auto.remove(r)
        self.auto_rows = []
        if self.add_entry.get_parent() is not None:
            self.auto.remove(self.add_entry)
        for i, cmd in enumerate(self.st.s.get("autostart", [])):
            row = Adw.ActionRow(title=GLib.markup_escape_text(cmd), use_markup=True)
            b = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"])
            b.connect("clicked", self.on_remove, i)
            row.add_suffix(b)
            self.auto.add(row)
            self.auto_rows.append(row)
        self.auto.add(self.add_entry)

    def on_add(self, row):
        cmd = row.get_text().strip()
        if not cmd:
            return
        self.st.s["autostart"] = self.st.s.get("autostart", []) + [cmd]
        P.save_settings(self.st.s)
        row.set_text("")
        self.render_auto()

    def on_remove(self, _b, i):
        lst = list(self.st.s.get("autostart", []))
        lst.pop(i)
        self.st.s["autostart"] = lst
        P.save_settings(self.st.s)
        self.render_auto()


class AboutPage(Adw.PreferencesPage):
    def __init__(self, st):
        super().__init__(title="About", icon_name="help-about-symbolic")
        t = st.theme()
        g = Adw.PreferencesGroup()
        hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_bottom=12)
        hero.append(Gtk.Label(label="◆ Prism", css_classes=["hero-title"]))
        hero.append(Gtk.Label(label="Hyprland rice · v%s · theme: %s" % (P.VERSION, t["NAME"]), css_classes=["dim-label"]))
        g.add(hero)
        self.add(g)
        g = Adw.PreferencesGroup(title="Shortcuts")
        g.add(button_row("Keybind cheat sheet", "Super+F1", "Show", lambda: P.spawn(["prism-keybinds"])))
        g.add(button_row("Theme quick-picker", "Super+T", "Open", lambda: P.spawn(["prism-theme-menu"])))
        self.add(g)
        g = Adw.PreferencesGroup(title="Advanced")
        g.add(button_row("Your own Hyprland tweaks", "~/.config/hypr/custom.lua — loaded last, never overwritten",
                         "Edit", self.edit_custom))
        g.add(button_row("Config folder", "~/.config", "Open", lambda: P.spawn(["xdg-open", P.CONFIG])))
        g.add(button_row("Regenerate everything", "Rewrite every config from the current theme + settings",
                         "Re-apply", lambda: st.schedule(wallpaper=True, delay=10)))
        self.add(g)

    def edit_custom(self):
        path = os.path.join(P.CONFIG, "hypr", "custom.lua")
        if not os.path.exists(path):
            P.write(path, "-- Your Hyprland tweaks. Example:\n-- hl.bind(\"SUPER + Z\", hl.dsp.exec_cmd(\"zeditor\"))\n")
        P.spawn(["xdg-open", path])


# ----------------------------------------------------------------------------
# Window
# ----------------------------------------------------------------------------
PAGES = [
    ("themes", "Themes", "applications-graphics-symbolic", ThemesPage),
    ("wallpaper", "Wallpaper", "image-x-generic-symbolic", WallpaperPage),
    ("look", "Appearance", "preferences-desktop-appearance-symbolic", LookPage),
    ("input", "Input", "input-keyboard-symbolic", InputPage),
    ("displays", "Displays", "video-display-symbolic", DisplayPage),
    ("power", "Power & Lock", "system-shutdown-symbolic", PowerPage),
    ("apps", "Apps & Startup", "application-x-executable-symbolic", AppsPage),
    ("about", "About", "help-about-symbolic", AboutPage),
]


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Prism Settings", default_width=980, default_height=680,
                         width_request=360, height_request=420)
        self.st = Settings(self)
        self.toasts = Adw.ToastOverlay()

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=150)
        self.pages = {}
        for key, title, _icon, cls in PAGES:
            page = cls(self.st)
            self.pages[key] = page
            self.stack.add_named(page, key)

        listbox = Gtk.ListBox(css_classes=["navigation-sidebar"])
        for key, title, icon, _ in PAGES:
            row = Gtk.ListBoxRow()
            row.key = key
            b = Gtk.Box(spacing=12, margin_top=8, margin_bottom=8, margin_start=6)
            b.append(Gtk.Image.new_from_icon_name(icon))
            b.append(Gtk.Label(label=title, xalign=0))
            row.set_child(b)
            listbox.append(row)

        side_tv = Adw.ToolbarView()
        side_tv.add_top_bar(Adw.HeaderBar(show_title=False))
        side_tv.set_content(scrolled(listbox))
        side = Adw.NavigationPage(title="Prism", child=side_tv)

        content_tv = Adw.ToolbarView()
        hb = Adw.HeaderBar()
        content_tv.add_top_bar(hb)
        content_tv.set_content(self.stack)
        content = Adw.NavigationPage(title="Themes", child=content_tv)
        titles = {k: t for k, t, _i, _c in PAGES}

        def on_row(_l, row):
            if row:
                self.stack.set_visible_child_name(row.key)
                content.set_title(titles[row.key])
        listbox.connect("row-selected", on_row)
        listbox.select_row(listbox.get_row_at_index(0))

        split = Adw.NavigationSplitView(sidebar=side, content=content, min_sidebar_width=200, max_sidebar_width=240)
        self.toasts.set_child(split)
        self.set_content(self.toasts)

        bp = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 640sp"))
        bp.add_setter(split, "collapsed", True)
        self.add_breakpoint(bp)

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text), timeout=2))
        return False

    def refresh_pages(self, skip=None):
        """Rebuild pages whose 'theme default' values depend on the current theme."""
        for key, _t, _i, cls in PAGES:
            if key in ("themes", "displays", "input", "power", "apps") or key == skip:
                continue
            visible = self.stack.get_visible_child_name()
            old = self.pages[key]
            self.stack.remove(old)
            new = cls(self.st)
            self.pages[key] = new
            self.stack.add_named(new, key)
            if visible == key:
                self.stack.set_visible_child_name(key)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            prov = Gtk.CssProvider()
            prov.load_from_data(CSS + swatch_css())
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            win = Window(self)
        win.present()


if __name__ == "__main__":
    if not P.list_themes():
        print("No Prism themes found in %s — run install.sh first." % P.THEMES_DIR, file=sys.stderr)
        sys.exit(1)
    sys.exit(App().run(sys.argv))
