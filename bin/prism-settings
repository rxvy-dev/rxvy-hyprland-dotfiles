        g.add(spin_row(st, "Repeat rate", "repeat_rate", 10, 80, 1, subtitle="Keys per second"))
        g.add(spin_row(st, "Repeat delay", "repeat_delay", 150, 1000, 25, subtitle="Milliseconds"))
        self.add(g)
        g = Adw.PreferencesGroup(title="Mouse and touchpad")
        g.add(spin_row(st, "Pointer speed", "sensitivity", -1.0, 1.0, 0.05, digits=2, cast=float))
        g.add(switch_row(st, "Flat acceleration", "accel_flat", "Recommended for gaming"))
        g.add(switch_row(st, "Natural scrolling (mouse)", "natural_scroll"))
        g.add(switch_row(st, "Natural scrolling (touchpad)", "touchpad_natural_scroll"))
