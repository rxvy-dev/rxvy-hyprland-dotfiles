#!/usr/bin/env bash
# Screenshots: prism-screenshot [region|screen|window]
# Copies to clipboard, saves to ~/Pictures/Screenshots, click the notification to edit.
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
case "${1:-region}" in
    region) geo=$(slurp -d) || exit 1; grim -g "$geo" "$file" ;;
    window)
        geo=$(hyprctl -j activewindow | python3 -c 'import json,sys; w=json.load(sys.stdin); print("%d,%d %dx%d"%(w["at"][0],w["at"][1],w["size"][0],w["size"][1]))') || exit 1
        grim -g "$geo" "$file" ;;
    *) grim "$file" ;;
esac
[ -f "$file" ] || exit 1
wl-copy < "$file"
(
  act=$(notify-send -a Prism -i "$file" "Screenshot saved" "${file/#$HOME/~} · copied to clipboard" -A edit=Edit -A open=Folder)
  case "$act" in
      edit) if command -v swappy >/dev/null; then swappy -f "$file"; fi ;;
      open) xdg-open "$dir" ;;
  esac
) &
